{
  "name": "@dsh-external/dsh-ultra-memory",
  "version": "0.2.0",
  "description": "DSH 独立工程记忆、分层条件注入、主动进度查询与可选上下文压缩",
  "type": "module",
  "private": false,
  "main": "./lib/index.js",
  "types": "./lib/types/memory-plugin.d.ts",
  "files": [
    "lib",
    "src",
    "core-src",
    "scripts",
    "SOURCE-MANIFEST.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "tsconfig.json"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/memory-plugin.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayou-31/Ultra-Memory.git"
  },
  "engines": {
    "dsh": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "node": ">=22"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
